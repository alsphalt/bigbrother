# Copy this file to .env. Never commit .env or share its contents.
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret

# Google OAuth (optional until configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (optional until configured)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Payment provider credentials are intentionally not included.
# Configure an eligible, approved provider account before accepting real money.
