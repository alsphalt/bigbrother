# Copy this file to .env. Never commit .env or share its contents.
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Where the SQLite database and session store live.
# Wallets and logins are lost on redeploy unless this path is persistent.
# On Vercel leave this unset (or use /tmp): an unwritable path falls back to
# /tmp/darknote-cloud, which is erased on every cold start.
DATABASE_DIR=./data

# Google OAuth (optional until configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (optional until configured)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- M-Pesa (Safaricom Daraja) ----------
# Without these five values the deposit sheet refuses with "M-Pesa is not configured".
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Public HTTPS endpoint M-Pesa can reach: https://your-domain/api/mpesa/callback
MPESA_CALLBACK_URL=
# Long random string; appended to the callback URL as ?k=... and checked on every call.
MPESA_CALLBACK_SECRET=
# CustomerPayBillOnline for a paybill, CustomerBuyGoodsOnline for a till number.
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# Local testing only: no Safaricom call, the deposit confirms itself after ~4s.
# Ignored when NODE_ENV=production.
MPESA_SIMULATE=0

# ---------- Android app version feed ----------
# Where the APK comes from. Public API, but a token raises the GitHub rate limit.
GITHUB_REPO=alsphalt/bigbrother
GITHUB_TOKEN=
# Optional: force the website stamp the app compares against. Defaults to the
# Vercel commit SHA, or a hash of the public assets on a plain server.
APP_VERSION=

# Payment provider credentials are never committed.
